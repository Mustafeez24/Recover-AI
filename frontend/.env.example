# Local development only. Copy this file to .env.local (already gitignored)
# and adjust if your backend runs elsewhere.
#
# Production values (e.g. the deployed Render backend URL) are NOT set
# here or anywhere in source -- they're configured as an environment
# variable on the hosting platform (Render/Vercel dashboard) at build
# time, since NEXT_PUBLIC_* vars are inlined into the client bundle by
# `next build`. See README §9 for the deployment steps.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
